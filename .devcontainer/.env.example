# =============================================================
# このファイルをコピーして .env を作成し、実際の値を入れてください
#   cp .devcontainer/.env.example .devcontainer/.env
# .env は絶対にGit管理しないこと(.gitignore済み)
# =============================================================

# --- proxmox-guest プロジェクト用 ---
# Proxmox APIトークン (形式: USER@REALM!TOKENID=UUID)
ANSIBLE_PROXMOX_GUEST_API_TOKEN=

# --- proxmox-personal プロジェクト用 ---
ANSIBLE_PROXMOX_PERSONAL_API_TOKEN=

# --- dev-vm (cloud-init経由で作成するVM) へのSSH秘密鍵パス ---
# ホスト側の鍵をコンテナ内 /root/.ssh/ にマウントしている前提のパス
ANSIBLE_DEV_VM_PRIVATE_KEY_FILE=/root/.ssh/dev-vm-ssh

# --- k3s プロジェクト用 ---
ANSIBLE_K3S_PRIVATE_KEY_FILE=/root/.ssh/k3s-ssh
