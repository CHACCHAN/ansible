{
    "name": "Ansible Dev",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "ANSIBLE_HOST_KEY_CHECKING": "False",
        "ANSIBLE_STDOUT_CALLBACK": "default",
        "ANSIBLE_RESULT_FORMAT": "yaml",
        "LANG": "en_US.UTF-8",
        "LANGUAGE": "en_US:en",
        "LC_ALL": "en_US.UTF-8"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "redhat.vscode-yaml",
                "ms-python.python",
                "ms-python.pylint",
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "editorconfig.editorconfig",
                "streetsidesoftware.code-spell-checker",
                "gruntfuss.vscode-nginx-conf-hint",
                "anthropic.claude-code",
                "openai.chatgpt",
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "ms-azuretools.vscode-docker",
                "mikestead.dotenv",
                "pkief.material-icon-theme"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "ansible.python.interpreterPath": "/usr/local/bin/python",
                "ansible.validation.lint.enabled": true,
                "yaml.schemas": {
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/tasks": [
                        "proxmox-hosts/**/tasks/**/*.yml",
                        "proxmox-vms/**/tasks/**/*.yml"
                    ],
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/playbook": [
                        "proxmox-hosts/**/playbooks/**/*.yml",
                        "proxmox-vms/**/playbooks/**/*.yml"
                    ]
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.tabSize": 2
                },
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.shell.linux": "/bin/bash",
                "workbench.iconTheme": "material-icon-theme",
                "explorer.compactFolders": false,
                "material-icon-theme.folders.associations": {
                    "proxmox-hosts": "project",
                    "proxmox-vms": "project",
                    "kubernetes": "kubernetes",
                    "roles": "components",
                    "playbooks": "pipe",
                    "group_vars": "constant",
                    "host_vars": "constant",
                    "inventory": "database",
                    "vault": "keys"
                }
            }
        }
    }
}
