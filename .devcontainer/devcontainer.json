{
    "name": "Ansible Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.cline,target=/root/.cline,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind",
        "source=${localWorkspaceFolder}/.cache/pip,target=/root/.cache/pip,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/.ansible,target=/root/.ansible,type=bind,consistency=cached"
    ],
    "runArgs": [
        "--env-file",
        ".devcontainer/.env"
    ],
    "containerEnv": {
        "ANSIBLE_HOST_KEY_CHECKING": "False",
        "ANSIBLE_STDOUT_CALLBACK": "default",
        "ANSIBLE_RESULT_FORMAT": "yaml"
    },
    "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.ansible ${localWorkspaceFolder}/.cache/pip",
    "postCreateCommand": "bash .devcontainer/postCreate.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "redhat.vscode-yaml",
                "ms-python.python",
                "ms-python.pylint",
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "editorconfig.editorconfig",
                "streetsidesoftware.code-spell-checker",
                "gruntfuss.vscode-nginx-conf-hint",
                "anthropic.claude-code",
                "saoudrizwan.claude-dev",
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "ms-azuretools.vscode-docker",
                "mikestead.dotenv",
                "pkief.material-icon-theme"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "ansible.python.interpreterPath": "/usr/local/bin/python",
                "ansible.validation.lint.enabled": true,
                "yaml.schemas": {
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/tasks": [
                        "proxmox-guest-hosts/**/tasks/**/*.yml",
                        "proxmox-guest-vms/**/tasks/**/*.yml",
                        "proxmox-guest/**/tasks/**/*.yml",
                        "kubernetes/**/tasks/**/*.yml"
                    ],
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/playbook": [
                        "proxmox-guest-hosts/**/playbooks/**/*.yml",
                        "proxmox-guest-vms/**/playbooks/**/*.yml",
                        "proxmox-guest/**/playbooks/**/*.yml",
                        "kubernetes/**/playbooks/**/*.yml"
                    ]
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.tabSize": 2
                },
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.shell.linux": "/bin/bash",
                "workbench.iconTheme": "material-icon-theme",
                "explorer.compactFolders": false,
                "material-icon-theme.folders.associations": {
                    "proxmox-guest-hosts": "kubernetes",
                    "proxmox-guest-vms": "kubernetes",
                    "proxmox-guest": "project",
                    "proxmox-personal": "project",
                    "kubernetes": "kubernetes",
                    "roles": "components",
                    "playbooks": "pipe",
                    "group_vars": "constant",
                    "host_vars": "constant",
                    "inventory": "database",
                    "vault": "keys"
                }
            }
        }
    }
}
